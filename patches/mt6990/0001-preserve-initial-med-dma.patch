+		s->tx_base && s->tx_count == 12150 &&
+		s->rx_mask == 0x30000 && s->rx_group == 0x30000 &&
+		s->fdma_mask == 0x80000000 &&
+		s->fdma_global == 0x40002004 &&
+		s->mdma_global == 0x10804825 &&
+		(s->cdmm_ctrl & 6) == 6;
+}
