From: Karin-Laboratory contributors
Subject: [RFC PATCH] net: mediatek: rebase reset-work serialization for OpenWrt 6.18.55
SPDX-License-Identifier: GPL-2.0-only

Rebased RFC 0002 for the exact OpenWrt prepared kernel source at
openwrt/openwrt a25fb079b1463cd5d7d69c6d9a1c28d873291ebb. Includes
the OpenWrt mtk_mac_config reset-work producer. Apply after RFC 0001 and
only after the OpenWrt source fingerprint gate passes.

diff --git a/drivers/net/ethernet/mediatek/mtk_eth_soc.c b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
index c8196cd..1164e5c 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -715,7 +715,7 @@ static void mtk_mac_config(struct phylink_config *config, unsigned int mode,
 		     mac->interface == PHY_INTERFACE_MODE_NA) &&
 		    !mtk_check_gmac23_idle(mac) &&
 		    !test_bit(MTK_RESETTING, &eth->state))
-			schedule_work(&eth->pending_work);
+			mtk_queue_reset_work(eth);
 	}
 
 	mac->interface = state->interface;
@@ -3614,21 +3614,52 @@ static bool mtk_hw_reset_check(struct mtk_eth *eth)
 	       (val & MTK_FE_INT_TSO_ALIGN) || (val & MTK_FE_INT_TSO_ILLEGAL);
 }
 
+/* Caller holds reset_queue_lock. */
+static void __mtk_queue_reset_work(struct mtk_eth *eth)
+{
+	if (!eth->reset_queue_stopping)
+		schedule_work(&eth->pending_work);
+}
+
+static void mtk_queue_reset_work(struct mtk_eth *eth)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&eth->reset_queue_lock, flags);
+	__mtk_queue_reset_work(eth);
+	spin_unlock_irqrestore(&eth->reset_queue_lock, flags);
+}
+
+static void mtk_stop_reset_work(struct mtk_eth *eth)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&eth->reset_queue_lock, flags);
+	eth->reset_queue_stopping = true;
+	spin_unlock_irqrestore(&eth->reset_queue_lock, flags);
+
+	cancel_work_sync(&eth->pending_work);
+	cancel_delayed_work_sync(&eth->reset.monitor_work);
+}
+
 static void mtk_tx_timeout(struct net_device *dev, unsigned int txqueue)
 {
 	struct mtk_mac *mac = netdev_priv(dev);
 	struct mtk_eth *eth = mac->hw;
+	unsigned long flags;
 
-	if (test_bit(MTK_RESETTING, &eth->state))
-		return;
-
-	if (!mtk_hw_reset_check(eth))
+	spin_lock_irqsave(&eth->reset_queue_lock, flags);
+	if (eth->reset_queue_stopping || test_bit(MTK_RESETTING, &eth->state) ||
+	    !mtk_hw_reset_check(eth)) {
+		spin_unlock_irqrestore(&eth->reset_queue_lock, flags);
 		return;
+	}
 
 	eth->netdev[mac->id]->stats.tx_errors++;
-	netif_err(eth, tx_err, dev, "transmit timed out\n");
+	__mtk_queue_reset_work(eth);
+	spin_unlock_irqrestore(&eth->reset_queue_lock, flags);
 
-	schedule_work(&eth->pending_work);
+	netif_err(eth, tx_err, dev, "transmit timed out\n");
 }
 
 static int mtk_get_irqs(struct platform_device *pdev, struct mtk_eth *eth)
@@ -4484,11 +4515,19 @@ static void mtk_hw_reset_monitor_work(struct work_struct *work)
 
 	/* DMA stuck checks */
 	if (mtk_hw_check_dma_hang(eth))
-		schedule_work(&eth->pending_work);
+		mtk_queue_reset_work(eth);
 
 out:
-	schedule_delayed_work(&eth->reset.monitor_work,
-			      MTK_DMA_MONITOR_TIMEOUT);
+	/* Serialize monitor rearm with the remove and probe-unwind stop. */
+	{
+		unsigned long flags;
+
+		spin_lock_irqsave(&eth->reset_queue_lock, flags);
+		if (!eth->reset_queue_stopping)
+			schedule_delayed_work(&eth->reset.monitor_work,
+					     MTK_DMA_MONITOR_TIMEOUT);
+		spin_unlock_irqrestore(&eth->reset_queue_lock, flags);
+	}
 }
 
 static int mtk_hw_init(struct mtk_eth *eth, bool reset)
@@ -5622,6 +5661,7 @@ static int mtk_probe(struct platform_device *pdev)
 	struct resource *res = NULL;
 	struct device_node *mac_np;
 	struct mtk_eth *eth;
+	unsigned long registered_netdevs = 0;
 	int err, i;
 
 	eth = devm_kzalloc(&pdev->dev, sizeof(*eth), GFP_KERNEL);
@@ -5654,6 +5694,8 @@ static int mtk_probe(struct platform_device *pdev)
 	spin_lock_init(&eth->tx_irq_lock);
 	spin_lock_init(&eth->rx_irq_lock);
 	spin_lock_init(&eth->dim_lock);
+	spin_lock_init(&eth->reset_queue_lock);
+	eth->reset_queue_stopping = false;
 
 	eth->rx_dim.mode = DIM_CQ_PERIOD_MODE_START_FROM_EQE;
 	INIT_WORK(&eth->rx_dim.work, mtk_dim_rx);
@@ -5875,11 +5917,13 @@ static int mtk_probe(struct platform_device *pdev)
 		err = register_netdev(eth->netdev[i]);
 		if (err) {
 			dev_err(eth->dev, "error bringing up device\n");
-			goto err_unreg_netdev;
-		} else
+			goto err_deinit_ppe;
+		} else {
+			set_bit(i, &registered_netdevs);
 			netif_info(eth, probe, eth->netdev[i],
 				   "mediatek frame engine at 0x%08lx, irq %d\n",
 				   eth->netdev[i]->base_addr, eth->irq[MTK_FE_IRQ_SHARED]);
+		}
 	}
 
 	/* we run 2 devices on the same DMA ring so we need a dummy device
@@ -5889,7 +5933,7 @@ static int mtk_probe(struct platform_device *pdev)
 	if (!eth->dummy_dev) {
 		err = -ENOMEM;
 		dev_err(eth->dev, "failed to allocated dummy device\n");
-		goto err_unreg_netdev;
+		goto err_deinit_ppe;
 	}
 	eth->dummy_dev->threaded = 1;
 	strcpy(eth->dummy_dev->name, "mtk_eth");
@@ -5902,9 +5946,20 @@ static int mtk_probe(struct platform_device *pdev)
 
 	return 0;
 
-err_unreg_netdev:
-	mtk_unreg_dev(eth);
 err_deinit_ppe:
+	/* Stop producers before unregistering devices or freeing reset resources. */
+	mtk_stop_reset_work(eth);
+	for (i = 0; i < MTK_MAX_DEVS; i++) {
+		struct mtk_mac *mac;
+
+		if (!eth->netdev[i])
+			continue;
+		mac = netdev_priv(eth->netdev[i]);
+		if (MTK_HAS_CAPS(eth->soc->caps, MTK_QDMA))
+			unregister_netdevice_notifier(&mac->device_notifier);
+		if (test_bit(i, &registered_netdevs))
+			unregister_netdev(eth->netdev[i]);
+	}
 	mtk_ppe_deinit(eth);
 	mtk_mdio_cleanup(eth);
 err_free_dev:
@@ -5925,6 +5980,9 @@ static void mtk_remove(struct platform_device *pdev)
 	struct mtk_mac *mac;
 	int i;
 
+	/* Latch producers off and drain work before touching devices or hardware. */
+	mtk_stop_reset_work(eth);
+
 	/* stop all devices to make sure that dma is properly shut down */
 	for (i = 0; i < MTK_MAX_DEVS; i++) {
 		if (!eth->netdev[i])
@@ -5934,9 +5992,6 @@ static void mtk_remove(struct platform_device *pdev)
 		phylink_disconnect_phy(mac->phylink);
 	}
 
-	cancel_work_sync(&eth->pending_work);
-	cancel_delayed_work_sync(&eth->reset.monitor_work);
-
 	mtk_wed_exit();
 	mtk_hw_deinit(eth);
 
diff --git a/drivers/net/ethernet/mediatek/mtk_eth_soc.h b/drivers/net/ethernet/mediatek/mtk_eth_soc.h
index accf484..c58ba74 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.h
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.h
@@ -1372,6 +1372,8 @@ struct mtk_soc_data {
  * @clks:		clock array for all clocks required
  * @mii_bus:		If there is a bus we need to create an instance for it
  * @pending_work:	The workqueue used to reset the dma ring
+ * @reset_queue_lock:	Serializes reset-work producers with teardown
+ * @reset_queue_stopping:	Prevents new reset-work scheduling during teardown
  * @state:		Initialization and runtime state of the device
  * @soc:		Holding specific data among various SoCs
  */
@@ -1410,6 +1412,8 @@ struct mtk_eth {
 	struct mii_bus			*mii_bus;
 	unsigned int			mdc_divider;
 	struct work_struct		pending_work;
+	spinlock_t			reset_queue_lock;
+	bool				reset_queue_stopping;
 	unsigned long			state;
 
 	const struct mtk_soc_data	*soc;
