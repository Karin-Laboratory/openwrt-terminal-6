#!/bin/sh
# SPDX-License-Identifier: MIT
# Research-only procd service registration; no uplink/AP configuration.
[ "${1:-}" = boot ] || exit 0
if /bin/ubus -t 5 call service add '{"name":"netifd","instances":{"netifd":{"command":["/sbin/netifd"],"respawn":["3600","5","5"]}}}' >/dev/null; then
    # The first marker proves procd accepted the real ubus service-add call.
    echo 'SBAT6_PROCD_NETIFD_REGISTERED' > /dev/console
else
    echo 'SBAT6_PROCD_NETIFD_REGISTRATION_FAILED' > /dev/console
    exit 1
fi

# The service-add reply is asynchronous. Verify that the real kernel exposes
# a stable netifd process, not merely a registered service definition.
# QEMU virt has no NIC and this is NOT a network/AP traffic assertion.
netifd_pid() {
    for comm in /proc/[0-9]*/comm; do
        [ -r "$comm" ] || continue
        IFS= read -r name < "$comm" || continue
        [ "$name" = netifd ] || continue
        pid=${comm#/proc/}
        printf '%s\n' "${pid%/comm}"
        return 0
    done
    return 1
}
attempt=0
stable=0
while [ "$attempt" -lt 20 ]; do
    if pid="$(netifd_pid)"; then
        /bin/busybox sleep 1 || exit 1
        if [ "$(netifd_pid)" = "$pid" ]; then
            echo 'SBAT6_NETIFD_PROCESS_STABLE_RUNTIME_PASS' > /dev/console
            stable=1
            break
        fi
    fi
    attempt=$((attempt + 1))
    /bin/busybox sleep 1 || exit 1
done
if [ "$stable" -ne 1 ]; then
    echo 'SBAT6_NETIFD_PROCESS_NOT_STABLE' > /dev/console
    exit 1
fi

# This optional exercise is activated ONLY by the isolated QEMU virt CI
# kernel command line. The normal research stage remains loopback-only.
# It proves real netifd -> kernel bridge creation, not Air6 Ethernet or AP.
# The stage ships BusyBox as /bin/busybox, without individual applet
# symlinks. Use shell builtins for cmdline and explicit BusyBox for sleep.
if ! IFS= read -r cmdline < /proc/cmdline; then
    echo 'SBAT6_QEMU_BRIDGE_CMDLINE_UNREADABLE' > /dev/console
    exit 1
fi
case " $cmdline " in
    *" sbat6.qemu_bridge_smoke=1 "*) ;;
    *) exit 0 ;;
esac
echo 'SBAT6_QEMU_BRIDGE_GATE_ENABLED' > /dev/console
if [ -e /sys/class/net/eth0 ]; then
    echo 'SBAT6_QEMU_BRIDGE_UNEXPECTED_NIC' > /dev/console
    exit 1
fi
# A deliberately empty bridge has no external ports, IP address, DHCP or NAT.
# The matching interface keeps the device active for netifd's device graph.
# Keep UCI errors visible on the guest console. A failed configuration
# must never be interpreted as an absent kernel bridge or a passing test.
if /sbin/uci batch >/dev/console 2>&1 <<'UCI'
set network.sbat6_bridge=device
set network.sbat6_bridge.name=br-sbat6
set network.sbat6_bridge.type=bridge
set network.sbat6_bridge.bridge_empty=1
set network.sbat6_bridge_mgmt=interface
set network.sbat6_bridge_mgmt.device=br-sbat6
set network.sbat6_bridge_mgmt.proto=none
commit network
UCI
then
    echo 'SBAT6_QEMU_BRIDGE_UCI_COMMIT_OK' > /dev/console
else
    echo 'SBAT6_QEMU_BRIDGE_UCI_COMMIT_FAILED' > /dev/console
    exit 1
fi
attempt=0
while [ "$attempt" -lt 20 ]; do
    if /bin/ubus -t 5 call network reload '{}' >/dev/null 2>&1; then
        break
    fi
    attempt=$((attempt + 1))
    /bin/busybox sleep 1 || exit 1
done
if [ "$attempt" -eq 20 ]; then
    echo 'SBAT6_NETIFD_BRIDGE_RELOAD_FAILED' > /dev/console
    exit 1
fi
attempt=0
while [ "$attempt" -lt 20 ]; do
    if [ -d /sys/class/net/br-sbat6/bridge ]; then
        echo 'SBAT6_NETIFD_EMPTY_BRIDGE_RUNTIME_PASS' > /dev/console
        exit 0
    fi
    attempt=$((attempt + 1))
    /bin/busybox sleep 1 || exit 1
done
echo 'SBAT6_NETIFD_BRIDGE_NOT_CREATED' > /dev/console
exit 1
